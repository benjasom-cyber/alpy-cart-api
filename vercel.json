{
  "functions": {
    "api/cart.js": {
      "memory": 128,
      "maxDuration": 5
    },
    "api/get-booking.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/cancel-booking.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/generate-quote.js": {
      "memory": 512,
      "maxDuration": 60
    },
    "api/search-bookings.js": {
      "memory": 128,
      "maxDuration": 15
    },
    "api/get-cheapest-shop.js": {
      "memory": 128,
      "maxDuration": 15
    },
    "api/execute-date-change.js": {
      "memory": 128,
      "maxDuration": 15
    },
    "api/odin-auth.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/support.js": {
      "memory": 256,
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/check-date-change",
      "destination": "/api/support?action=check-date-change"
