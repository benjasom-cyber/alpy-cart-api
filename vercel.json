    {
      "source": "/api/find-nearest-shop",
      "destination": "/api/support?action=find-nearest-shop"
    },
    {
      "source": "/api/update-personal-info",
      "destination": "/api/support?action=update-personal-info"
    },
    {
      "source": "/api/unsubscribe-newsletter",
      "destination": "/api/support?action=unsubscribe-newsletter"
    },
    {
      "source": "/api/large-group-quote",
      "destination": "/api/support?action=large-group-quote"
    },
    {
      "source": "/api/resend-voucher",
      "destination": "/api/support?action=resend-voucher"
    },
    {
      "source": "/api/knowledge",
      "destination": "/api/support?action=knowledge"
    },
    {
      "source": "/api/review-run",
      "destination": "/api/support?action=review-run"
    },
    {
      "source": "/api/review-digest",
      "destination": "/api/support?action=review-digest"
    },
    {
      "source": "/api/review-report",
      "destination": "/api/support?action=review-report"
    },
    {
      "source": "/api/training-run",
      "destination": "/api/support?action=training-run"
